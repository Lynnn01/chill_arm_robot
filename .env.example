# เลือก platform: windows หรือ linux (ถ้าไม่กำหนดจะ auto-detect จาก OS)
# MYCOBOT_PLATFORM=windows
# MYCOBOT_PLATFORM=linux

# Windows: COM10  |  Linux/Jetson: /dev/ttyUSB0
MYCOBOT_PORT=/dev/ttyUSB0
MYCOBOT_BAUD=1000000

LLM_BASE_URL=https://prodsvc.educg.net/deepseek/v1/
LLM_MODEL_NAME=deepseek
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_VOICE_KEY=MOO_DEANG

QWEN_VL_URL=https://prodsvc.educg.net/serve-qwen25-vl-7b-instruct/v1
QWEN_VL_MODEL=qwen2.5-vl:7b
QWEN_VL_API_KEY=EMPTY

# เลือก index กล้องเริ่มต้น (0 หรือ 1 เป็นต้น)
CAMERA_INDEX=0

# =============================================================================
# STACKING & GRABBING SETTINGS
# =============================================================================
GRAB_BASE_HEIGHT=110
STACK_BASE_HEIGHT=90
STACK_HEIGHT_PER_LAYER=30
STACK_SAFE_OFFSET=25
GRAB_X_OFFSET=-15
GRAB_Y_OFFSET=-5
STACK_X_OFFSET=0
STACK_Y_OFFSET=5

# พิกัดพื้นที่ปลอดภัยระหว่าง unstack (mm)
UNSTACK_SAFE_X=160.0
UNSTACK_SAFE_Y=-150.0

